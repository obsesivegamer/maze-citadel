; Engine configuration file.
; Keep hand edits minimal; Godot rewrites this file when settings change.

config_version=5

[application]

config/name="Maze Citadel"
config/version="0.1.0"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/use_custom_user_dir=true
config/custom_user_dir_name="Maze Citadel"

[display]

window/size/viewport_width=1600
window/size/viewport_height=1000
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/dpi/allow_hidpi=true

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/driver.macos="metal"
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/glow/upscale_mode=0
anti_aliasing/quality/use_debanding=true
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.42, 0.58, 0.82, 1)
